# Supabase keys for cloud sync + login (required at BUILD time for Vite)
# Get values from Supabase Dashboard → Settings → API
#
# Local dev: copy this file to .env.local, fill in keys, restart `npm run dev`
# Vercel: Project → Settings → Environment Variables → add both vars → Redeploy
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=your_anon_key_here
