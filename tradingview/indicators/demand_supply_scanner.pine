    array.push(parts, rowText(sym33, s33, sc33))
if s34 != SIG_NONE
    array.push(parts, rowText(sym34, s34, sc34))
if s35 != SIG_NONE
    array.push(parts, rowText(sym35, s35, sc35))
if s36 != SIG_NONE
    array.push(parts, rowText(sym36, s36, sc36))
if s37 != SIG_NONE
    array.push(parts, rowText(sym37, s37, sc37))
if s38 != SIG_NONE
    array.push(parts, rowText(sym38, s38, sc38))
if s39 != SIG_NONE
    array.push(parts, rowText(sym39, s39, sc39))
if s40 != SIG_NONE
    array.push(parts, rowText(sym40, s40, sc40))

consolidated = array.size(parts) > 0 ? array.join(parts, " | ") : ""

if consolidated != "" and (not alertOnNewOnly or consolidated != prevAlertMsg) and barstate.isconfirmed
    alert("D&S Scanner: " + consolidated, alert.freq_once_per_bar_close)

if barstate.isconfirmed
    prevAlertMsg := consolidated

alertcondition(consolidated != "", "D&S Scanner — Any Signal", "D&S Scanner: signals active on one or more symbols")

// Pane summary: green bars = BUY count, red bars = SELL count
buyCount  = (s01 == SIG_BUY ? 1 : 0) + (s02 == SIG_BUY ? 1 : 0) + (s03 == SIG_BUY ? 1 : 0) + (s04 == SIG_BUY ? 1 : 0) + (s05 == SIG_BUY ? 1 : 0) + (s06 == SIG_BUY ? 1 : 0) + (s07 == SIG_BUY ? 1 : 0) + (s08 == SIG_BUY ? 1 : 0) + (s09 == SIG_BUY ? 1 : 0) + (s10 == SIG_BUY ? 1 : 0) + (s11 == SIG_BUY ? 1 : 0) + (s12 == SIG_BUY ? 1 : 0) + (s13 == SIG_BUY ? 1 : 0) + (s14 == SIG_BUY ? 1 : 0) + (s15 == SIG_BUY ? 1 : 0) + (s16 == SIG_BUY ? 1 : 0) + (s17 == SIG_BUY ? 1 : 0) + (s18 == SIG_BUY ? 1 : 0) + (s19 == SIG_BUY ? 1 : 0) + (s20 == SIG_BUY ? 1 : 0) + (s21 == SIG_BUY ? 1 : 0) + (s22 == SIG_BUY ? 1 : 0) + (s23 == SIG_BUY ? 1 : 0) + (s24 == SIG_BUY ? 1 : 0) + (s25 == SIG_BUY ? 1 : 0) + (s26 == SIG_BUY ? 1 : 0) + (s27 == SIG_BUY ? 1 : 0) + (s28 == SIG_BUY ? 1 : 0) + (s29 == SIG_BUY ? 1 : 0) + (s30 == SIG_BUY ? 1 : 0) + (s31 == SIG_BUY ? 1 : 0) + (s32 == SIG_BUY ? 1 : 0) + (s33 == SIG_BUY ? 1 : 0) + (s34 == SIG_BUY ? 1 : 0) + (s35 == SIG_BUY ? 1 : 0) + (s36 == SIG_BUY ? 1 : 0) + (s37 == SIG_BUY ? 1 : 0) + (s38 == SIG_BUY ? 1 : 0) + (s39 == SIG_BUY ? 1 : 0) + (s40 == SIG_BUY ? 1 : 0)
sellCount = (s01 == SIG_SELL ? 1 : 0) + (s02 == SIG_SELL ? 1 : 0) + (s03 == SIG_SELL ? 1 : 0) + (s04 == SIG_SELL ? 1 : 0) + (s05 == SIG_SELL ? 1 : 0) + (s06 == SIG_SELL ? 1 : 0) + (s07 == SIG_SELL ? 1 : 0) + (s08 == SIG_SELL ? 1 : 0) + (s09 == SIG_SELL ? 1 : 0) + (s10 == SIG_SELL ? 1 : 0) + (s11 == SIG_SELL ? 1 : 0) + (s12 == SIG_SELL ? 1 : 0) + (s13 == SIG_SELL ? 1 : 0) + (s14 == SIG_SELL ? 1 : 0) + (s15 == SIG_SELL ? 1 : 0) + (s16 == SIG_SELL ? 1 : 0) + (s17 == SIG_SELL ? 1 : 0) + (s18 == SIG_SELL ? 1 : 0) + (s19 == SIG_SELL ? 1 : 0) + (s20 == SIG_SELL ? 1 : 0) + (s21 == SIG_SELL ? 1 : 0) + (s22 == SIG_SELL ? 1 : 0) + (s23 == SIG_SELL ? 1 : 0) + (s24 == SIG_SELL ? 1 : 0) + (s25 == SIG_SELL ? 1 : 0) + (s26 == SIG_SELL ? 1 : 0) + (s27 == SIG_SELL ? 1 : 0) + (s28 == SIG_SELL ? 1 : 0) + (s29 == SIG_SELL ? 1 : 0) + (s30 == SIG_SELL ? 1 : 0) + (s31 == SIG_SELL ? 1 : 0) + (s32 == SIG_SELL ? 1 : 0) + (s33 == SIG_SELL ? 1 : 0) + (s34 == SIG_SELL ? 1 : 0) + (s35 == SIG_SELL ? 1 : 0) + (s36 == SIG_SELL ? 1 : 0) + (s37 == SIG_SELL ? 1 : 0) + (s38 == SIG_SELL ? 1 : 0) + (s39 == SIG_SELL ? 1 : 0) + (s40 == SIG_SELL ? 1 : 0)

plot(buyCount, "BUY Count", color=color.new(color.lime, 0), style=plot.style_columns)
plot(-sellCount, "SELL Count", color=color.new(color.red, 0), style=plot.style_columns)
hline(0, "Zero", color=color.gray, linestyle=hline.style_dotted)