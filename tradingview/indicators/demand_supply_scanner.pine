// ══════════════════════════════════════════════════════════════════════════════
// CONSTANTS
// ══════════════════════════════════════════════════════════════════════════════

int SIG_NONE = 0
int SIG_BUY  = 1
int SIG_SELL = 2

int FRESH_OK       = 0
int FRESH_VIOLATED = 1

// ══════════════════════════════════════════════════════════════════════════════
// CANDLE HELPERS (scanTF series inside request.security)
// ══════════════════════════════════════════════════════════════════════════════

cBody(int i) =>
    math.abs(close[i] - open[i])

cRange(int i) =>
    high[i] - low[i]

bodyPct(int i) =>
    float r = cRange(i)
    r == 0.0 ? na : cBody(i) / r

isLeg(int i) =>
    float bp = bodyPct(i)
    not na(bp) and bp >= legBodyPct

isBase(int i) =>
    float bp = bodyPct(i)
    not na(bp) and bp < legBodyPct

isBull(int i) =>
    close[i] > open[i]

isBear(int i) =>
    close[i] < open[i]

bodyTop(int i) =>
    math.max(open[i], close[i])

bodyBot(int i) =>
    math.min(open[i], close[i])

hasGapUp(int i) =>
    gapHandling and open[i] > high[i + 1]

hasGapDn(int i) =>
    gapHandling and open[i] < low[i + 1]

// ══════════════════════════════════════════════════════════════════════════════
// ZONE DETECTION — DBR / RBR / RBD / DBD (same rules as full strategy)
// ══════════════════════════════════════════════════════════════════════════════

detectNewZone() =>
    bool  found   = false
    float zProx   = na
    bool  zDemand = false
    int   zBases  = 0
    float zLegStr = 0.0
    bool  zGap    = false

    if isLeg(0) and cRange(0) > 0
        for bc = maxBaseCandles to 1
            int legInOff = bc + 1
            if legInOff > bar_index
                break
            if not isLeg(legInOff) or cRange(legInOff) == 0
                continue
            bool allBase = true
            for b = 1 to bc
                if not isBase(b) or cRange(b) == 0
                    allBase := false
            if not allBase
                continue

            float proxVal = na
            bool  demand  = false

            if isBear(legInOff) and isBull(0)
                demand  := true
                proxVal := bodyTop(1)
                for b = 2 to bc
                    proxVal := math.max(proxVal, bodyTop(b))
            else if isBull(legInOff) and isBull(0)
                demand  := true
                proxVal := bodyTop(1)
                for b = 2 to bc
                    proxVal := math.max(proxVal, bodyTop(b))
            else if isBull(legInOff) and isBear(0)
                demand  := false
                proxVal := bodyBot(1)
                for b = 2 to bc
                    proxVal := math.min(proxVal, bodyBot(b))
            else if isBear(legInOff) and isBear(0)
                demand  := false
                proxVal := bodyBot(1)
                for b = 2 to bc
                    proxVal := math.min(proxVal, bodyBot(b))

            if not na(proxVal)
                float avgBaseRange = 0.0
                for b = 1 to bc
                    avgBaseRange += cRange(b)
                avgBaseRange /= bc
                float legMult = avgBaseRange > 0 ? cBody(0) / avgBaseRange : 0.0
                found   := true
                zProx   := proxVal
                zDemand := demand
                zBases  := bc
                zLegStr := legMult
                zGap    := hasGapUp(0) or hasGapDn(0)
                break
    [found, zProx, zDemand, zBases, zLegStr, zGap]

quickScore(float legMult, bool gapF, int bases) =>
    int s = 2
    s += gapF or legMult >= strongLegMult ? 2 : 0
    s += bases <= 3 ? 1 : 0
    s

// ══════════════════════════════════════════════════════════════════════════════
// ZONE ENGINE — runs on scanTF inside request.security (1 call per symbol)
// Returns [signal, score, distPct] before trend filter
// ══════════════════════════════════════════════════════════════════════════════

f_zoneScan() =>
    var float[] zProx   = array.new_float()
    var bool[]  zDemand = array.new_bool()
    var int[]   zBases  = array.new_int()
    var float[] zLegStr = array.new_float()
    var bool[]  zGap    = array.new_bool()
    var int[]   zFresh  = array.new_int()
    var int[]   zBar    = array.new_int()

    [nf, np, ndm, nbc, nls, ngap] = detectNewZone()
    if nf and not barstate.isfirst
        array.push(zProx, np)
        array.push(zDemand, ndm)
        array.push(zBases, nbc)
        array.push(zLegStr, nls)
        array.push(zGap, ngap)
        array.push(zFresh, FRESH_OK)
        array.push(zBar, bar_index)
        while array.size(zProx) > maxZonesStored
            array.shift(zProx)
            array.shift(zDemand)
            array.shift(zBases)
            array.shift(zLegStr)
            array.shift(zGap)
            array.shift(zFresh)
            array.shift(zBar)

    int zSize = array.size(zProx)
    if zSize > 0
        for i = 0 to zSize - 1
            if array.get(zFresh, i) == FRESH_OK
                float px = array.get(zProx, i)
                bool  dm = array.get(zDemand, i)
                if dm and close < px
                    array.set(zFresh, i, FRESH_VIOLATED)
                if not dm and close > px
                    array.set(zFresh, i, FRESH_VIOLATED)

    int   demIdx = na
    int   supIdx = na
    int   demBar = -1
    int   supBar = -1
    if zSize > 0
        for i = 0 to zSize - 1
            if array.get(zFresh, i) == FRESH_OK
                int zb = array.get(zBar, i)
                if array.get(zDemand, i) and zb > demBar
                    demBar := zb
                    demIdx := i
                if not array.get(zDemand, i) and zb > supBar
                    supBar := zb
                    supIdx := i

    float dProx = na(demIdx) ? na : array.get(zProx, demIdx)
    float sProx = na(supIdx) ? na : array.get(zProx, supIdx)
    int   dSc   = na(demIdx) ? 0 : quickScore(array.get(zLegStr, demIdx), array.get(zGap, demIdx), array.get(zBases, demIdx))
    int   sSc   = na(supIdx) ? 0 : quickScore(array.get(zLegStr, supIdx), array.get(zGap, supIdx), array.get(zBases, supIdx))

    bool nearD = not na(dProx) and dProx > 0 and math.abs(close - dProx) / dProx * 100.0 <= proxBufferPct and dSc >= minScore
    bool nearS = not na(sProx) and sProx > 0 and math.abs(close - sProx) / sProx * 100.0 <= proxBufferPct and sSc >= minScore

    int   signal  = SIG_NONE
    int   score   = 0
    float distPct = na

    if nearD and nearS
        if dSc > sSc
            signal  := SIG_BUY
            score   := dSc
            distPct := math.abs(close - dProx) / dProx * 100.0
        else if sSc > dSc
            signal  := SIG_SELL
            score   := sSc
            distPct := math.abs(close - sProx) / sProx * 100.0
        else if math.abs(close - dProx) <= math.abs(close - sProx)
            signal  := SIG_BUY
            score   := dSc
            distPct := math.abs(close - dProx) / dProx * 100.0
        else
            signal  := SIG_SELL
            score   := sSc
            distPct := math.abs(close - sProx) / sProx * 100.0
    else if nearD
        signal  := SIG_BUY
        score   := dSc
        distPct := math.abs(close - dProx) / dProx * 100.0
    else if nearS
        signal  := SIG_SELL
        score   := sSc
        distPct := math.abs(close - sProx) / sProx * 100.0

    [signal, score, distPct]

// Trend bias on trendTF (2nd security call per symbol)
f_trendBias() =>
    float sma = ta.sma(close, smaLen)
    float slope = sma - sma[slopeLen]
    slope > 0 ? 1 : slope < 0 ? -1 : 0

// Apply trend gate: BUY if not bearish, SELL if not bullish
applyTrend(int sig, int sc, float dist, int trend) =>
    int   outSig  = sig
    int   outSc   = sc
    float outDist = dist
    if sig == SIG_BUY and trend < 0
        outSig  := SIG_NONE
        outSc   := 0
        outDist := na
    if sig == SIG_SELL and trend > 0
        outSig  := SIG_NONE
        outSc   := 0
        outDist := na
    [outSig, outSc, outDist]

scanSymbol(string sym) =>
    [rawSig, rawSc, rawDist] = request.security(sym, scanTF, f_zoneScan(), lookahead=barmerge.lookahead_off, ignore_invalid_symbol=true)
    int trend = request.security(sym, trendTF, f_trendBias(), lookahead=barmerge.lookahead_off, ignore_invalid_symbol=true)
    applyTrend(rawSig, rawSc, rawDist, trend)

// ══════════════════════════════════════════════════════════════════════════════
// SCAN ALL 40 SYMBOLS
// ══════════════════════════════════════════════════════════════════════════════

[s01, sc01, d01] = scanSymbol(sym01)
[s02, sc02, d02] = scanSymbol(sym02)
[s03, sc03, d03] = scanSymbol(sym03)
[s04, sc04, d04] = scanSymbol(sym04)
[s05, sc05, d05] = scanSymbol(sym05)
