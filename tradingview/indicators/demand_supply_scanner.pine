[s21, sc21, d21] = scanSymbol(sym21)
[s22, sc22, d22] = scanSymbol(sym22)
[s23, sc23, d23] = scanSymbol(sym23)
[s24, sc24, d24] = scanSymbol(sym24)
[s25, sc25, d25] = scanSymbol(sym25)
[s26, sc26, d26] = scanSymbol(sym26)
[s27, sc27, d27] = scanSymbol(sym27)
[s28, sc28, d28] = scanSymbol(sym28)
[s29, sc29, d29] = scanSymbol(sym29)
[s30, sc30, d30] = scanSymbol(sym30)
[s31, sc31, d31] = scanSymbol(sym31)
[s32, sc32, d32] = scanSymbol(sym32)
[s33, sc33, d33] = scanSymbol(sym33)
[s34, sc34, d34] = scanSymbol(sym34)
[s35, sc35, d35] = scanSymbol(sym35)
[s36, sc36, d36] = scanSymbol(sym36)
[s37, sc37, d37] = scanSymbol(sym37)
