[s39, sc39, d39] = scanSymbol(sym39)
[s40, sc40, d40] = scanSymbol(sym40)

// ══════════════════════════════════════════════════════════════════════════════
// DISPLAY HELPERS
// ══════════════════════════════════════════════════════════════════════════════

symShort(string sym) =>
    int c = str.pos(sym, ":")
    c >= 0 ? str.substring(sym, c + 1) : sym

sigLabel(int sig) =>
    sig == SIG_BUY ? "BUY" : sig == SIG_SELL ? "SELL" : "—"

sigColor(int sig) =>
    sig == SIG_BUY ? color.lime : sig == SIG_SELL ? color.red : color.gray

rowText(string sym, int sig, int sc) =>
    sig != SIG_NONE ? symShort(sym) + ":" + sigLabel(sig) + "(" + str.tostring(sc) + ")" : ""

// ══════════════════════════════════════════════════════════════════════════════
// RESULTS TABLE
// ══════════════════════════════════════════════════════════════════════════════

var table resTbl = table.new(position.bottom_right, 4, 41, bgcolor=color.new(color.black, 85), border_width=1)

if showTable and barstate.islast
    table.cell(resTbl, 0, 0, "Symbol", text_color=color.gray, text_size=size.small)
    table.cell(resTbl, 1, 0, "Signal", text_color=color.gray, text_size=size.small)
    table.cell(resTbl, 2, 0, "Score", text_color=color.gray, text_size=size.small)
    table.cell(resTbl, 3, 0, "Dist%", text_color=color.gray, text_size=size.small)

    string[] syms  = array.from(sym01, sym02, sym03, sym04, sym05, sym06, sym07, sym08, sym09, sym10, sym11, sym12, sym13, sym14, sym15, sym16, sym17, sym18, sym19, sym20, sym21, sym22, sym23, sym24, sym25, sym26, sym27, sym28, sym29, sym30, sym31, sym32, sym33, sym34, sym35, sym36, sym37, sym38, sym39, sym40)
    int[]    sigs  = array.from(s01, s02, s03, s04, s05, s06, s07, s08, s09, s10, s11, s12, s13, s14, s15, s16, s17, s18, s19, s20, s21, s22, s23, s24, s25, s26, s27, s28, s29, s30, s31, s32, s33, s34, s35, s36, s37, s38, s39, s40)
    int[]    scs   = array.from(sc01, sc02, sc03, sc04, sc05, sc06, sc07, sc08, sc09, sc10, sc11, sc12, sc13, sc14, sc15, sc16, sc17, sc18, sc19, sc20, sc21, sc22, sc23, sc24, sc25, sc26, sc27, sc28, sc29, sc30, sc31, sc32, sc33, sc34, sc35, sc36, sc37, sc38, sc39, sc40)
    float[]  dists = array.from(d01, d02, d03, d04, d05, d06, d07, d08, d09, d10, d11, d12, d13, d14, d15, d16, d17, d18, d19, d20, d21, d22, d23, d24, d25, d26, d27, d28, d29, d30, d31, d32, d33, d34, d35, d36, d37, d38, d39, d40)

    int row = 1
    for i = 0 to 39
        int sg = array.get(sigs, i)
        if sg != SIG_NONE
            table.cell(resTbl, 0, row, symShort(array.get(syms, i)), text_color=color.white, text_size=size.small)
            table.cell(resTbl, 1, row, sigLabel(sg), text_color=sigColor(sg), text_size=size.small)
            table.cell(resTbl, 2, row, str.tostring(array.get(scs, i)) + "/5", text_color=color.white, text_size=size.small)
            float dv = array.get(dists, i)
            table.cell(resTbl, 3, row, na(dv) ? "—" : str.tostring(dv, "#.##") + "%", text_color=color.white, text_size=size.small)
            row += 1

    if row == 1
        table.cell(resTbl, 0, 1, "—", text_color=color.gray, text_size=size.small)
        table.cell(resTbl, 1, 1, "No signals", text_color=color.gray, text_size=size.small)
        table.cell(resTbl, 2, 1, "", text_size=size.small)
        table.cell(resTbl, 3, 1, "", text_size=size.small)

